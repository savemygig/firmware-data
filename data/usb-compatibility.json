{
  "title": "USB drive compatibility for standalone DJ players, by model",
  "description": "Which file systems each standalone DJ player reads (FAT32, exFAT, HFS+, NTFS), which rekordbox library format it expects (Device Library or OneLibrary) or whether it runs Engine DJ, and the maker document each row rests on.",
  "page": "https://www.savemygig.com/knowledge/usb-compatibility",
  "publisher": "Save My Gig",
  "reviewed": "31 August 2026",
  "license": "CC BY 4.0",
  "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
  "terms": "Licensed CC BY 4.0: free to reuse, quote and redistribute, with credit to Save My Gig and a link to https://www.savemygig.com/knowledge/usb-compatibility. Every row names the document it rests on.",
  "fields": {
    "fat32": "Yes where the maker lists it. On AlphaTheta and Pioneer DJ rows this is the whole-table rule.",
    "exfat": "AlphaTheta and Pioneer DJ rows are decided by the rekordbox FAQ; Engine rows by the maker document.",
    "hfsPlus": "Yes or No where the maker says so; \"not listed\" where the shared Engine OS guide never mentions it; null where this site holds no source.",
    "ntfs": "No only where the maker says so; null where this site holds no source.",
    "firstPartitionOnly": "true where the manual says only the first partition of a drive is read.",
    "reads": "the file-system statement as this site holds it, in English, from the model documentation."
  },
